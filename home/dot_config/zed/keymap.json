// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-o": "pane::GoBack",
      "ctrl-i": "pane::GoForward",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // "shift-y": ["workspace::SendKeystrokes", "y $"] // Use neovim's yank behavior: yank to end of line.
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore" // In insert mode, make jk escape to normal mode.
    },
  },

  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-i": "editor::ShowCompletions",
    },
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd",
    },
  },

  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "g a": "git::StageAll",
    },
  },
  {
    "context": "GitDiff > Editor",
    "unbind": {
      "ctrl-space": "git::StageAll",
    },
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "bindings": {
      "g a": "git::StageAll",
    },
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "unbind": {
      "shift-x": "git::StageAll",
    },
  },
  {
    "context": "(vim_mode ) && !menu",
    "bindings": {
      "alt-o": "editor::SelectLargerSyntaxNode",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
    },
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "o": ["vim::PushAddSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == ys",
    "bindings": {
      "o": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "o": "vim::PushDeleteSurrounds",
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "o": ["vim::PushChangeSurrounds", {}],
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-o": "vim::PushAddSurrounds",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-b": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-b": "vim::PageUp",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-b": ["vim::Literal", ["ctrl-b", "\u0002"]],
    },
  },
]
